# Public frontend URL served directly by the R2 bucket's custom domain.
VITE_PUZZLES_URL=https://puzzles.example.com/puzzles.json

# Server-side publishing configuration. Copy to .env.local and fill in credentials.
# Keep R2 credentials unprefixed: VITE_ variables are exposed to the browser.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=nighty-akari-puzzles
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
